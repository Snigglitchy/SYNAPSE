A real screenshot of the purple network will outperform any designed graphic — it looks authentic, not like an ad. -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.8.5/d3.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<style>
  :root{
    --bg: #fdfcff; --panel: #f5f1fc; --line: #e6def6;
    --ink: #1c1730; --ink-muted: #6f6580;
    --purple: #6d28d9; --purple-mid: #9061e8; --purple-soft: #b9a4f0; --purple-pale: #ece4fb;
    --white: #ffffff;
  }
  *{ box-sizing: border-box; }
  body{ margin:0; background:var(--bg); color:var(--ink); font-family:'Inter',-apple-system,sans-serif; }
  .wrap{ max-width: 1180px; margin: 0 auto; padding: 0 32px 70px; }

  header{ position: relative; padding: 56px 0 20px; overflow: hidden; }
  .dendrite{ position:absolute; top:-30px; left:0; width:100%; height:260px; opacity:.18; pointer-events:none; }
  .dendrite path{ stroke: var(--purple); fill:none; stroke-width:1.1; }
  .dendrite circle{ fill: var(--purple); }
  .brand{ position: relative; z-index: 1; }
  h1.wordmark{ font-family:'Fraunces',serif; font-weight:600; font-size:46px; letter-spacing:2px; margin:0; color:var(--ink); }
  .fullform{ font-family:'IBM Plex Mono', monospace; font-size:11.5px; letter-spacing:.5px; color:var(--purple); margin:6px 0 0; text-transform: uppercase; }
  p.tagline{ font-family:'Inter',sans-serif; color:var(--ink-muted); font-size:15px; margin:10px 0 0; }
  .stat-strip{ font-family:'IBM Plex Mono', monospace; font-size:12px; color:var(--purple-mid); margin-top:16px; }

  .how-btn{ font-family:'Inter',sans-serif; font-weight:600; font-size:13px; color:var(--purple); background:transparent; border:1.5px solid var(--purple-soft); border-radius:999px; padding:7px 16px; margin-top:14px; cursor:pointer; }
  .how-btn:hover{ background:var(--purple-pale); }
  .modal-overlay{ display:none; position:fixed; inset:0; background:rgba(28,23,48,0.55); z-index:60; align-items:center; justify-content:center; padding:20px; }
  .modal-overlay.active{ display:flex; }
  .modal-box{ background:var(--white); border-radius:18px; padding:34px; max-width:540px; max-height:82vh; overflow-y:auto; position:relative; }
  .modal-box h3{ font-family:'Fraunces',serif; font-size:24px; margin:0 0 6px; color:var(--ink); }
  .modal-box .modal-sub{ color:var(--ink-muted); font-size:13px; margin-bottom:20px; }
  .modal-box ol{ padding-left:20px; margin:0 0 20px; }
  .modal-box li{ font-size:14px; line-height:1.6; color:var(--ink); margin-bottom:10px; }
  .modal-box .sources{ background:var(--panel); border-radius:12px; padding:14px 18px; font-size:12.5px; color:var(--ink-muted); line-height:1.6; }
  .modal-close{ position:absolute; top:20px; right:22px; background:none; border:none; font-size:18px; color:var(--ink-muted); cursor:pointer; }

  .steps{ display:flex; gap:0; margin-top:26px; border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
  .step{ flex:1; padding:14px 16px; border-right:1px solid var(--line); }
  .step:last-child{ border-right:none; }
  .step .n{ font-family:'IBM Plex Mono', monospace; font-size:11px; color:var(--purple); }
  .step .t{ font-size:13px; color:var(--ink); font-weight:500; margin-top:3px; }

  .search-block{ padding: 30px 0 8px; }
  .search-row{ display:flex; gap:10px; }
  #searchInput{ flex:1; font-family:'Inter',sans-serif; font-size:16px; padding:14px 18px; border:1.5px solid var(--line); border-radius:999px; background:var(--white); color:var(--ink); outline:none; }
  #searchInput:focus{ border-color: var(--purple-soft); }
  #searchBtn{ font-family:'Inter',sans-serif; font-weight:600; font-size:14px; background:var(--purple); color:var(--white); border:none; border-radius:999px; padding:0 26px; cursor:pointer; }
  #searchBtn:hover{ background:#5b21b6; }
  #searchBtn:disabled{ background:var(--purple-soft); cursor:not-allowed; }
  .chips{ display:flex; flex-wrap:wrap; gap:8px; margin:14px 0 0; }
  .chip{ font-family:'IBM Plex Mono', monospace; font-size:12px; color:var(--purple); background:var(--purple-pale); border:none; border-radius:999px; padding:6px 13px; cursor:pointer; }
  .chip:hover{ background:var(--purple-soft); color:var(--white); }

  .filters{ margin-top:18px; background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:16px 20px; display:flex; align-items:end; gap:22px; flex-wrap:wrap; }
  .filter-item{ display:flex; flex-direction:column; gap:5px; }
  .filter-item label{ font-family:'IBM Plex Mono', monospace; font-size:10.5px; color:var(--ink-muted); text-transform:uppercase; letter-spacing:.4px; }
  .filter-item select, .filter-item input{ font-family:'Inter',sans-serif; font-size:14px; padding:8px 10px; border:1px solid var(--line); border-radius:8px; background:var(--white); color:var(--ink); width:110px; }
  #applyFiltersBtn{ font-family:'Inter',sans-serif; font-weight:600; font-size:13px; background:var(--white); color:var(--purple); border:1.5px solid var(--purple); border-radius:8px; padding:9px 16px; cursor:pointer; }
  #applyFiltersBtn:hover{ background:var(--purple-pale); }
  .filters .tip{ font-size:11.5px; color:var(--ink-muted); flex-basis:100%; margin-top:2px; }

  .breadcrumb{ margin-top:20px; font-size:13px; color:var(--ink-muted); display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
  .breadcrumb button{ background:none; border:none; color:var(--purple); font-family:'Inter',sans-serif; font-size:13px; cursor:pointer; padding:0; font-weight:600; }
  #status{ font-family:'IBM Plex Mono', monospace; font-size:12px; color:var(--purple-mid); min-height:18px; margin-top:6px; }

  .paper-summary{ margin-top:18px; background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:16px 20px; display:none; }
  .paper-summary h4{ font-family:'Fraunces',serif; font-size:15px; margin:0 0 8px; color:var(--ink); }
  .paper-summary p{ font-size:13.5px; line-height:1.6; color:var(--ink); margin:0; }
  .paper-summary .note{ font-family:'IBM Plex Mono', monospace; font-size:10.5px; color:var(--ink-muted); margin-top:8px; }

  .stage{ display:flex; gap:20px; margin-top:16px; align-items:flex-start; }
  #graph-container, #mymap-graph{ flex:1; background:var(--white); border:1px solid var(--line); border-radius:16px; overflow:hidden; min-height: 200px; }
  .node-label{ fill:var(--ink); font-family:'Inter',sans-serif; font-size:11px; font-weight:500; pointer-events:none; }
  .hint{ color:var(--ink-muted); font-size:12.5px; margin-top:10px; }

  #panel{ width:300px; flex-shrink:0; background:var(--panel); border:1px solid var(--line); border-radius:16px; padding:20px; display:none; max-height:560px; overflow-y:auto; }
  #panel.active{ display:block; }
  #panel .close{ float:right; background:none; border:none; color:var(--ink-muted); cursor:pointer; font-size:16px; }
  #panel h3{ font-family:'Fraunces',serif; font-size:22px; margin:0 0 4px; color:var(--ink); }
  #panel .subline{ font-size:12px; color:var(--ink-muted); font-family:'IBM Plex Mono', monospace; margin-bottom:14px; }
  .sparkline{ display:flex; align-items:flex-end; gap:3px; height:44px; margin-bottom:16px; }
  .spark-bar{ flex:1; background:var(--purple-soft); border-radius:2px 2px 0 0; }
  .spark-labels{ display:flex; gap:3px; margin-bottom:18px; }
  .spark-labels span{ flex:1; font-family:'IBM Plex Mono', monospace; font-size:9px; color:var(--ink-muted); text-align:center; }
  .panel-actions{ display:flex; flex-direction:column; gap:8px; margin-bottom:18px; }
  .panel-actions button{ font-family:'Inter',sans-serif; font-size:13px; font-weight:600; border-radius:8px; padding:9px; cursor:pointer; border:1.5px solid var(--purple); }
  .btn-solid{ background:var(--purple); color:var(--white); }
  .btn-solid:hover{ background:#5b21b6; }
  .btn-outline{ background:transparent; color:var(--purple); }
  .btn-outline:hover{ background:var(--purple-pale); }
  .paper{ border-top:1px solid var(--line); padding:10px 0; }
  .paper a{ color:var(--ink); font-size:13px; font-weight:500; text-decoration:none; }
  .paper a:hover{ color:var(--purple); }
  .paper .meta{ font-family:'IBM Plex Mono', monospace; font-size:11px; color:var(--ink-muted); margin-top:3px; }

  #mymap{ margin-top: 46px; border-top:1px solid var(--line); padding-top:24px; }
  #mymap h2{ font-family:'Fraunces', serif; font-size: 24px; margin:0 0 4px; }
  #mymap .desc{ color:var(--ink-muted); font-size:13.5px; margin-bottom:16px; }
  #mymapChips{ margin-bottom: 14px; }
  .empty{ color:var(--ink-muted); font-size:13px; }
  .pin-chip{ display:inline-flex; align-items:center; gap:8px; font-family:'IBM Plex Mono', monospace; font-size:12px; background:var(--white); border:1.5px solid var(--purple-soft); color:var(--purple); border-radius:999px; padding:6px 8px 6px 13px; margin:0 6px 6px 0; cursor:pointer; }
  .pin-chip.selected{ background:var(--purple); color:var(--white); border-color:var(--purple); }
  .pin-chip .jump{ opacity:.7; }
  .pin-chip .x{ opacity:.55; }
  .pin-chip .x:hover{ opacity:1; }
  .map-actions{ display:flex; gap:10px; flex-wrap:wrap; margin-bottom: 10px; }
  .map-actions button{ font-family:'Inter',sans-serif; font-weight:600; font-size:13px; border-radius:999px; padding:9px 18px; cursor:pointer; border:1.5px solid var(--purple); }
  .map-controls{ display:flex; gap:22px; align-items:end; margin-bottom:16px; flex-wrap:wrap; }
  .map-status{ font-family:'IBM Plex Mono', monospace; font-size:12px; color:var(--purple-mid); min-height:18px; margin-bottom:8px; }
  .export-row{ display:flex; gap:8px; margin-top:12px; }
  .export-row button{ font-family:'IBM Plex Mono', monospace; font-size:12px; background:var(--white); color:var(--ink); border:1px solid var(--line); border-radius:8px; padding:8px 14px; cursor:pointer; }
  .export-row button:hover{ border-color: var(--purple-soft); color: var(--purple); }

  #aiResult{ margin-top:18px; display:none; }
  #aiResult.active{ display:block; }
  .ai-card{ background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:18px 20px; margin-bottom:12px; }
  .ai-card h4{ font-family:'Fraunces', serif; font-size:16px; margin:0 0 8px; color:var(--ink); }
  .ai-card p{ font-size:13.5px; line-height:1.6; color:var(--ink); margin:0; }
  .ai-card.relationship{ border-color: var(--purple-soft); background: var(--purple-pale); }
  .go-chips{ display:flex; flex-wrap:wrap; gap:6px; margin-top:10px; }
  .go-chip{ font-family:'IBM Plex Mono', monospace; font-size:10.5px; background:var(--white); border:1px solid var(--purple-soft); color:var(--purple); border-radius:999px; padding:4px 10px; }
  .ai-card .note{ font-family:'IBM Plex Mono', monospace; font-size:10.5px; color:var(--ink-muted); margin-top:10px; }

  #citation{ margin-top:60px; border-top:1px solid var(--line); padding-top:22px; }
  #citation h4{ font-family:'IBM Plex Mono', monospace; font-size:11px; text-transform:uppercase; letter-spacing:.5px; color:var(--ink-muted); margin:0 0 10px; }
  #citation p{ font-size:13.5px; color:var(--ink); line-height:1.6; max-width: 620px; }
  #citation button{ margin-top:8px; font-family:'IBM Plex Mono', monospace; font-size:11.5px; background:var(--white); color:var(--purple); border:1px solid var(--purple-soft); border-radius:8px; padding:7px 14px; cursor:pointer; }
  #citation .disclaimer{ font-size:11.5px; color:var(--ink-muted); margin-top:14px; max-width:620px; }

  @media (max-width: 820px) {
    .wrap{ padding: 0 18px 50px; }
    header{ padding: 40px 0 16px; }
    h1.wordmark{ font-size: 32px; letter-spacing: 1px; }
    .dendrite{ height: 160px; }
    .steps{ flex-direction: column; }
    .step{ border-right: none; border-bottom: 1px solid var(--line); }
    .step:last-child{ border-bottom: none; }
    .search-row{ flex-direction: column; }
    #searchBtn{ padding: 12px; }
    .filters{ flex-direction: column; align-items: stretch; }
    .filter-item select, .filter-item input{ width: 100%; }
    .stage{ flex-direction: column; }
    #graph-container, #mymap-graph{ width: 100%; }
    #graph-container svg, #mymap-graph svg{ width: 100%; height: auto; }
    #panel{ width: 100%; max-height: 420px; }
    .map-controls{ flex-direction: column; align-items: stretch; }
    .map-actions{ flex-direction: column; }
    .map-actions button{ width: 100%; }
    .export-row{ flex-wrap: wrap; }
  }
</style>
</head>
<body>

<div class="wrap">
  <header>
    <svg class="dendrite" viewBox="0 0 1180 260" preserveAspectRatio="none">
      <path d="M0,120 C150,60 220,180 340,90 C420,30 480,140 600,70"/>
      <path d="M600,70 C660,40 700,90 760,50 C820,10 880,60 940,20"/>
      <path d="M340,90 C360,140 300,160 320,210"/>
      <path d="M760,50 C800,90 850,70 900,110"/>
      <path d="M0,60 C60,20 100,70 160,30"/>
      <path d="M940,20 C990,50 1020,10 1070,40"/>
      <path d="M160,30 C200,60 180,100 230,120"/>
      <path d="M900,110 C950,140 930,180 980,200"/>
      <path d="M320,210 C280,230 340,250 300,270"/>
      <path d="M1070,40 C1100,70 1080,110 1130,130"/>
      <path d="M0,180 C40,200 20,230 70,240"/>
      <circle cx="340" cy="90" r="2.4"/><circle cx="760" cy="50" r="2.4"/>
      <circle cx="940" cy="20" r="2.4"/><circle cx="160" cy="30" r="2.4"/>
      <circle cx="900" cy="110" r="2.4"/><circle cx="1070" cy="40" r="2.4"/>
    </svg>
    <div class="brand">
      <h1 class="wordmark">SYNAPSE</h1>
      <div class="fullform">Systematic Yielding of Networked Associations from Published Scientific Evidence</div>
      <p class="tagline">A living map of glioblastoma research — built from what the field is actually writing about, right now.</p>
      <button id="howItWorksBtn" class="how-btn">How this works ↗</button>
      <div class="stat-strip" id="statStrip">— live from PubMed —</div>
    </div>
    <div class="steps">
      <div class="step"><div class="n">01</div><div class="t">Search PubMed for real GBM papers</div></div>
      <div class="step"><div class="n">02</div><div class="t">Extract genes, drugs &amp; pathways mentioned</div></div>
      <div class="step"><div class="n">03</div><div class="t">Map what appears together</div></div>
      <div class="step"><div class="n">04</div><div class="t">Explore, compare &amp; build your own map</div></div>
    </div>
  </header>

  <div class="search-block">
    <div class="search-row">
      <input id="searchInput" type="text" placeholder="Explore a gene, drug, or pathway — e.g. EGFR, temozolomide, PD-L1…">
      <button id="searchBtn">Explore</button>
    </div>
    <div class="chips" id="chips"></div>

    <div class="filters">
      <div class="filter-item">
        <label>Papers to scan</label>
        <select id="paperLimitSelect">
          <option value="50">50</option><option value="100">100</option>
          <option value="150" selected>150</option><option value="250">250</option><option value="400">400</option>
        </select>
      </div>
      <div class="filter-item"><label>From year</label><input type="number" id="yearFromInput" value="2015" min="1990" max="2026"></div>
      <div class="filter-item"><label>To year</label><input type="number" id="yearToInput" value="2026" min="1990" max="2026"></div>
      <button id="applyFiltersBtn">Apply filters</button>
      <div class="tip">Narrower year ranges load faster and can surface sharper, more recent trends. Wider ranges give the bigger picture.</div>
    </div>

    <div class="breadcrumb" id="breadcrumb"></div>
    <div id="status"></div>
    <div class="paper-summary" id="paperSummary">
      <h4>Papers at a glance</h4>
      <p id="paperSummaryText">Generating overview…</p>
      <div class="note" id="paperSummaryNote"></div>
    </div>
  </div>

  <div class="stage">
    <div id="graph-container"></div>
    <div id="panel"></div>
  </div>
  <p class="hint">Drag any node to rearrange. Click a node to see the real papers behind it. "Explore neighborhood" from inside an active search shows the shared ground between two concepts, not just a fresh lookup.</p>

  <div id="mymap">
    <h2>My Map</h2>
    <p class="desc">Pin concepts as you explore, select two or more, and build a standalone map of just what you care about — customized, explained, and exportable.</p>
    <div id="mymapChips"><span class="empty">Nothing pinned yet. Click a node above, then "Pin to my map."</span></div>

    <div class="map-controls">
      <div class="filter-item"><label>Nodes to show</label>
        <select id="nodeLimitSelect">
          <option value="5">Top 5</option><option value="10" selected>Top 10</option>
          <option value="15">Top 15</option><option value="9999">All</option>
        </select>
      </div>
      <div class="filter-item"><label>Palette</label>
        <select id="paletteSelect">
          <option value="violet">Violet</option><option value="ink">Monochrome ink</option>
          <option value="sunset">Sunset</option><option value="ocean">Ocean</option>
        </select>
      </div>
    </div>

    <div class="map-actions">
      <button class="btn-solid" id="buildMapBtn" style="background:var(--purple);color:#fff;">Build map from selected</button>
      <button class="btn-outline" id="explainBtn" style="background:transparent;color:var(--purple);">Explain these concepts</button>
    </div>
    <div class="map-status" id="mapStatus"></div>
    <div id="mymap-graph"></div>
    <div class="export-row" id="exportRow" style="display:none;">
      <button id="exportSvg">Export SVG</button>
      <button id="exportPng">Export PNG</button>
      <button id="exportPdf">Export PDF</button>
    </div>
    <div id="aiResult"></div>
  </div>

  <div id="citation">
    <h4>Cite this tool</h4>
    <p>Sarthak, S. (2026). <em>SYNAPSE: a living map of glioblastoma research</em> [interactive tool]. Built with Claude (Anthropic). Underlying data: NCBI PubMed / Entrez E-utilities, MyGene.info.</p>
    <button id="copyCiteBtn">Copy citation</button>
    <p class="disclaimer">SYNAPSE reflects patterns in published abstracts and AI-assisted synthesis — it is a research navigation aid, not a source of clinical or diagnostic guidance.</p>
  </div>
</div>

<div class="modal-overlay" id="howModal">
  <div class="modal-box">
    <button class="modal-close" id="closeModal">✕</button>
    <h3>How SYNAPSE works</h3>
    <p class="modal-sub">Everything you see starts from real, current PubMed papers — not a fixed dataset.</p>
    <ol>
      <li><strong>Start from the overview or search a concept.</strong> The map already loaded is the 150 most recent glioblastoma papers. Type a gene, drug, or pathway to search a specific one instead.</li>
      <li><strong>Click any node</strong> to see the actual papers, journals, and years behind it — every link goes straight to the real PubMed page.</li>
      <li><strong>"Explore neighborhood"</strong> drills one level deeper. If you're already inside a concept, this shows the shared ground between it and whatever you click next — not just a fresh search.</li>
      <li><strong>Pin</strong> anything interesting, then select two or more pins to <strong>build your own map</strong> and export it as SVG, PNG, or PDF.</li>
    </ol>
    <div class="sources">
      Gene/drug frequencies and connections are computed live from PubMed abstracts. Gene summaries and GO terms come from MyGene.info. The "papers at a glance" overview and relationship explanations are AI-generated syntheses — useful for quick orientation, not a substitute for reading the primary literature.
    </div>
  </div>
</div>

<script>
const BASE_DICTIONARY = [
  { id: 'EGFR', syns: ['EGFR', 'EGFRvIII'] },
  { id: 'IDH1', syns: ['IDH1'] },
  { id: 'IDH2', syns: ['IDH2'] },
  { id: 'MGMT', syns: ['MGMT'] },
  { id: 'TP53', syns: ['TP53', 'p53'] },
  { id: 'PTEN', syns: ['PTEN'] },
  { id: 'TERT', syns: ['TERT'] },
  { id: 'ATRX', syns: ['ATRX'] },
  { id: 'PDGFRA', syns: ['PDGFRA'] },
  { id: 'CDKN2A', syns: ['CDKN2A'] },
  { id: 'VEGF', syns: ['VEGF', 'VEGFA'] },
  { id: 'NF1', syns: ['NF1'] },
  { id: 'RB1', syns: ['RB1'] },
  { id: 'CIC', syns: ['CIC'] },
  { id: 'FUBP1', syns: ['FUBP1'] },
  { id: 'BRAF', syns: ['BRAF'] },
  { id: 'NTRK', syns: ['NTRK', 'NTRK1', 'NTRK2', 'NTRK3'] },
  { id: 'mTOR', syns: ['mTOR'] },
  { id: 'PI3K', syns: ['PI3K', 'PIK3CA'] },
  { id: 'STAT3', syns: ['STAT3'] },
  { id: 'Notch', syns: ['Notch', 'Notch1'] },
  { id: 'Wnt', syns: ['Wnt', 'beta-catenin'] },
  { id: 'temozolomide', syns: ['temozolomide', 'TMZ'] },
  { id: 'bevacizumab', syns: ['bevacizumab', 'Avastin'] },
  { id: 'dexamethasone', syns: ['dexamethasone'] },
  { id: 'immune checkpoint', syns: ['immune checkpoint', 'checkpoint inhibitor'] },
  { id: 'PD-1', syns: ['PD-1', 'PD1'] },
  { id: 'PD-L1', syns: ['PD-L1', 'PDL1'] },
  { id: 'CAR-T', syns: ['CAR-T', 'CAR T cell', 'chimeric antigen receptor'] },
  { id: 'glioma stem cells', syns: ['glioma stem cells', 'glioma stem cell', 'GSC'] },
  { id: 'blood-brain barrier', syns: ['blood-brain barrier', 'BBB'] },
  { id: 'radiotherapy', syns: ['radiotherapy', 'radiation therapy'] }
];
const BASE_IDS = BASE_DICTIONARY.map(d => d.id);
const SUGGESTED_CHIPS = ['EGFR','IDH1','MGMT','TP53','temozolomide','bevacizumab','PD-L1','Notch'];

function resolveToCanonical(term) {
  const lower = term.trim().toLowerCase();
  for (const d of BASE_DICTIONARY) if (d.syns.some(s => s.toLowerCase() === lower)) return d.id;
  return term.trim();
}
const PALETTES = {
  violet: { node: '#8352e0', center: '#5b21b6', link: '#b9a4f0' },
  ink:    { node: '#453f57', center: '#1c1730', link: '#cfc9dc' },
  sunset: { node: '#e0729f', center: '#b83c6d', link: '#f3c1d6' },
  ocean:  { node: '#4fa3c9', center: '#1f6f96', link: '#bfe0ef' }
};

const cache = {};
let currentChain = null;
let pinned = [];
let selectedPins = new Set();
let filters = { paperLimit: 150, yearFrom: 2015, yearTo: 2026 };

const statusEl = document.getElementById('status');
const statStrip = document.getElementById('statStrip');
const breadcrumbEl = document.getElementById('breadcrumb');
const chipsEl = document.getElementById('chips');
