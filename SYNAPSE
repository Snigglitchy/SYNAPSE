function escapeRegex(s){ return s.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&'); }
function filterSuffix(){ return `${filters.paperLimit}:${filters.yearFrom}-${filters.yearTo}`; }
function dateClause(){ return filters.yearFrom && filters.yearTo ? ` AND ("${filters.yearFrom}"[pdat] : "${filters.yearTo}"[pdat])` : ''; }

async function callClaude(prompt) {
  const response = await fetch("https://api.anthropic.com/v1/messages", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ model: "claude-sonnet-4-6", max_tokens: 1000, messages: [{ role: "user", content: prompt }] })
  });
  const data = await response.json();
  return (data.content || []).map(b => b.text || '').join('');
}

function parseArticle(node){
  const pmidEl = node.getElementsByTagName('PMID')[0];
  const titleEl = node.getElementsByTagName('ArticleTitle')[0];
  const journalEl = node.getElementsByTagName('ISOAbbreviation')[0];
  let year = '';
  const yearEl = node.getElementsByTagName('Year')[0];
  if (yearEl) year = yearEl.textContent;
  else {
    const medlineDateEl = node.getElementsByTagName('MedlineDate')[0];
    if (medlineDateEl) { const m = medlineDateEl.textContent.match(/\d{4}/); if (m) year = m[0]; }
  }
  const abstractNodes = node.getElementsByTagName('AbstractText');
  let abstractText = '';
  for (let k = 0; k < abstractNodes.length; k++) abstractText += ' ' + abstractNodes[k].textContent;
  return { pmid: pmidEl ? pmidEl.textContent : null, title: titleEl ? titleEl.textContent : '(untitled)',
    journal: journalEl ? journalEl.textContent : '', year, abstractText };
}

async function fetchAndExtract(query, retmax, dictionary) {
  const searchUrl = 'https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi' +
    `?db=pubmed&term=${encodeURIComponent(query)}&retmax=${retmax}&sort=date&retmode=json`;
  const searchRes = await fetch(searchUrl);
  const searchData = await searchRes.json();
  const ids = searchData.esearchresult.idlist;
  if (ids.length === 0) return { nodes: [], links: [], papersByTerm: {}, totalPapers: 0 };

  const efetchUrl = 'https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi' +
    `?db=pubmed&id=${ids.join(',')}&rettype=abstract&retmode=xml`;
  const efetchRes = await fetch(efetchUrl);
  const xmlText = await efetchRes.text();
  const xmlDoc = new DOMParser().parseFromString(xmlText, 'text/xml');
  const articleNodes = xmlDoc.getElementsByTagName('PubmedArticle');

  // Normalize the dictionary: plain strings become single-synonym groups,
  // so ad hoc search terms (not in BASE_DICTIONARY) still work unchanged.
  const normDict = dictionary.map(d => typeof d === 'string' ? { id: d, syns: [d] } : d);

  const frequency = {}, pairCounts = {}, papersByTerm = {};
  normDict.forEach(d => { frequency[d.id] = 0; papersByTerm[d.id] = []; });

  let scanned = 0;
  for (let i = 0; i < articleNodes.length; i++) {
    const p = parseArticle(articleNodes[i]);
    if (!p.abstractText.trim()) continue;
    scanned++;
    const found = [];
    normDict.forEach(d => {
      const pattern = new RegExp('\\b(' + d.syns.map(escapeRegex).join('|') + ')\\b', 'i');
      if (pattern.test(p.abstractText)) {
        frequency[d.id]++; found.push(d.id);
        papersByTerm[d.id].push({ pmid: p.pmid, title: p.title, journal: p.journal, year: p.year });
      }
    });
    for (let a = 0; a < found.length; a++)
      for (let b = a + 1; b < found.length; b++) {
        const key = [found[a], found[b]].sort().join('|');
        pairCounts[key] = (pairCounts[key] || 0) + 1;
      }
  }
  const nodes = Object.entries(frequency).filter(([t, c]) => c > 0).map(([t, c]) => ({ id: t, count: c }));
  const links = Object.entries(pairCounts).map(([key, count]) => {
    const [a, b] = key.split('|'); return { source: a, target: b, value: count };
  });
  return { nodes, links, papersByTerm, totalPapers: scanned };
}

function collectUniquePapers(papersByTerm) {
  const seen = new Set(), list = [];
  Object.values(papersByTerm).forEach(arr => arr.forEach(p => {
    if (p.pmid && !seen.has(p.pmid)) { seen.add(p.pmid); list.push(p); }
  }));
  return list;
}

async function generatePaperSummary(data) {
  const psEl = document.getElementById('paperSummary');
  const textEl = document.getElementById('paperSummaryText');
  const noteEl = document.getElementById('paperSummaryNote');
  const papers = collectUniquePapers(data.papersByTerm || {});
  if (papers.length === 0) { psEl.style.display = 'none'; return; }
  psEl.style.display = 'block';
  textEl.textContent = 'Generating a quick overview of these papers…';
  noteEl.textContent = '';
  const top = [...papers].sort((a, b) => (b.year || '0').localeCompare(a.year || '0')).slice(0, 20);
  const listText = top.map(p => `- ${p.title} (${p.year || 'n.d.'})`).join('\n');
  try {
    const text = await callClaude(
      `Here are recent glioblastoma paper titles:\n${listText}\n\nIn 3-4 sentences, summarize in plain language what this set of papers collectively suggests about current research focus or trends. Synthesize — do not just list the papers back.`
    );
    textEl.textContent = text || 'Could not generate a summary this time.';
    noteEl.textContent = `Synthesized by Claude from ${papers.length} unique papers in this batch. Titles are real; the synthesis is AI-generated.`;
  } catch (err) {
    textEl.textContent = 'Overview unavailable right now — the individual papers are still browsable via any node.';
  }
}

async function loadOverview() {
  currentChain = null;
  setBreadcrumb([{ label: 'Field overview' }]);
  const key = 'overview|' + filterSuffix();
  if (cache[key]) { renderAll(cache[key]); return; }
  statusEl.textContent = 'Scanning recent glioblastoma literature…';
  const query = 'glioblastoma' + dateClause();
  const data = await fetchAndExtract(query, filters.paperLimit, BASE_DICTIONARY);
  data.focusLabel = `Field overview — ${filters.paperLimit} most recent glioblastoma papers (${filters.yearFrom}–${filters.yearTo})`;
  data.chain = null;
  cache[key] = data;
  renderAll(data);
}

async function focusChain(newChain) {
  currentChain = newChain;
  const key = 'focus|' + newChain.join('>') + '|' + filterSuffix();
  const trail = [{ label: 'Field overview' }];
  newChain.forEach((t, i) => trail.push({ label: t, chain: newChain.slice(0, i + 1) }));
  setBreadcrumb(trail);
  if (cache[key]) { renderAll(cache[key]); return; }

  const queryTerms = newChain.slice(-2);
  const query = queryTerms.join(' AND ') + ' AND glioblastoma' + dateClause();
  const label = queryTerms.length > 1
    ? `Shared ground between "${queryTerms[0]}" and "${queryTerms[1]}"`
    : `Neighborhood of "${queryTerms[0]}"`;
  statusEl.textContent = `Searching PubMed: ${query}…`;
  searchBtn.disabled = true;
  try {
    const extraTerms = newChain.filter(t => !BASE_IDS.includes(t));
    const dict = [...BASE_DICTIONARY, ...extraTerms];
    const data = await fetchAndExtract(query, filters.paperLimit, dict);
    data.focusLabel = label;
    data.centerTerm = newChain[newChain.length - 1];
    data.chain = newChain;
    cache[key] = data;
    renderAll(data);
  } catch (err) {
    statusEl.textContent = 'Something went wrong: ' + err.message;
  } finally {
    searchBtn.disabled = false;
  }
}

function setBreadcrumb(trail) {
  breadcrumbEl.innerHTML = '';
  trail.forEach((step, i) => {
    if (i > 0) breadcrumbEl.appendChild(document.createTextNode('→'));
    if (i === trail.length - 1) {
      const span = document.createElement('span'); span.textContent = step.label;
      breadcrumbEl.appendChild(span);
    } else {
      const btn = document.createElement('button'); btn.textContent = step.label;
      btn.onclick = () => step.chain ? focusChain(step.chain) : loadOverview();
      breadcrumbEl.appendChild(btn);
    }
  });
}

function renderAll(data) {
  panelEl.classList.remove('active');
  statStrip.textContent = `${data.totalPapers} papers scanned · ${data.nodes.length} active entities · ${data.links.length} connections · live from PubMed`;
  statusEl.textContent = data.focusLabel || '';
  buildForceGraph('graph-container', data, data.chain, PALETTES.violet);
  generatePaperSummary(data);
}

function buildForceGraph(containerId, data, contextChain, colors) {
  colors = colors || PALETTES.violet;
  const container = document.getElementById(containerId);
  container.innerHTML = '';
  const { nodes, links, papersByTerm, centerTerm } = data;
  const width = 800, height = 540;
  if (!nodes || nodes.length === 0) {
    container.innerHTML = `<div style="padding:60px;text-align:center;color:var(--ink-muted);font-family:Inter,sans-serif;">No tracked entities showed up for this search. Try a different term or widen the filters.</div>`;
    return;
  }
  const radiusScale = d3.scaleSqrt().domain([1, d3.max(nodes, d => d.count)]).range([7, 28]);
  const widthScale = d3.scaleLinear().domain([1, d3.max(links, d => d.value) || 1]).range([1, 5]);

  const svg = d3.select('#' + containerId).append('svg')
    .attr('width', width).attr('height', height)
    .attr('viewBox', `0 0 ${width} ${height}`).attr('xmlns', 'http://www.w3.org/2000/svg');
  const defs = svg.append('defs');
  const filter = defs.append('filter').attr('id', 'soft-' + containerId).attr('x','-50%').attr('y','-50%').attr('width','200%').attr('height','200%');
  filter.append('feDropShadow').attr('dx',0).attr('dy',0).attr('stdDeviation',3).attr('flood-color',colors.center).attr('flood-opacity',0.35);

  const simulation = d3.forceSimulation(nodes)
    .force('link', d3.forceLink(links).id(d => d.id).distance(95).strength(0.35))
    .force('charge', d3.forceManyBody().strength(-240))
    .force('center', d3.forceCenter(width / 2, height / 2))
    .force('collision', d3.forceCollide(d => radiusScale(d.count) + 10));

  const link = svg.append('g').selectAll('line').data(links).join('line')
    .attr('stroke', colors.link).attr('stroke-opacity', 0.6).attr('stroke-width', d => widthScale(d.value));

  const node = svg.append('g').selectAll('circle').data(nodes).join('circle')
    .attr('r', d => radiusScale(d.count))
    .attr('fill', d => d.id === centerTerm ? colors.center : colors.node)
    .attr('filter', `url(#soft-${containerId})`)
    .style('cursor', 'pointer')
    .call(drag(simulation))
    .on('click', (event, d) => openPanel(d, papersByTerm[d.id] || [], contextChain));

  const label = svg.append('g').selectAll('text').data(nodes).join('text')
    .attr('class', 'node-label').attr('text-anchor', 'middle')
    .attr('dy', d => -radiusScale(d.count) - 8).text(d => d.id);

  simulation.on('tick', () => {
    link.attr('x1', d => d.source.x).attr('y1', d => d.source.y).attr('x2', d => d.target.x).attr('y2', d => d.target.y);
    node.attr('cx', d => d.x).attr('cy', d => d.y);
    label.attr('x', d => d.x).attr('y', d => d.y);
  });

  function drag(sim) {
    function started(e, d) { if (!e.active) sim.alphaTarget(0.3).restart(); d.fx = d.x; d.fy = d.y; }
    function dragged(e, d) { d.fx = e.x; d.fy = e.y; }
    function ended(e, d) { if (!e.active) sim.alphaTarget(0); d.fx = null; d.fy = null; }
    return d3.drag().on('start', started).on('drag', dragged).on('end', ended);
  }
}

function openPanel(node, papers, contextChain) {
  panelEl.classList.add('active');
  const yearCounts = {};
  papers.forEach(p => { if (p.year) yearCounts[p.year] = (yearCounts[p.year] || 0) + 1; });
  const years = Object.keys(yearCounts).sort();
  const maxYearCount = Math.max(1, ...Object.values(yearCounts));
  let sparkHtml = '', sparkLabels = '';
  years.forEach(y => {
    sparkHtml += `<div class="spark-bar" style="height:${(yearCounts[y]/maxYearCount*44)}px" title="${y}: ${yearCounts[y]}"></div>`;
    sparkLabels += `<span>${y.slice(2)}</span>`;
  });
  const sortedPapers = [...papers].sort((a, b) => (b.year || '0').localeCompare(a.year || '0')).slice(0, 12);
  let papersHtml = sortedPapers.map(p => `
    <div class="paper">
      <a href="https://pubmed.ncbi.nlm.nih.gov/${p.pmid}/" target="_blank" rel="noopener">${p.title}</a>
      <div class="meta">${p.journal || ''} ${p.journal ? '·' : ''} ${p.year || 'n.d.'} · PMID ${p.pmid}</div>
    </div>`).join('');

  panelEl.innerHTML = `
    <button class="close" id="panelClose">✕</button>
    <h3>${node.id}</h3>
    <div class="subline">mentioned in ${papers.length} of the scanned papers</div>
    ${years.length ? `<div class="sparkline">${sparkHtml}</div><div class="spark-labels">${sparkLabels}</div>` : ''}
    <div class="panel-actions">
      <button class="btn-solid" id="exploreBtn">Explore neighborhood of "${node.id}" →</button>
      <button class="btn-outline" id="pinBtn">+ Pin to my map</button>
    </div>
    <div>${papersHtml || '<span class="empty">No individual papers captured for this term.</span>'}</div>
  `;
  document.getElementById('panelClose').onclick = () => panelEl.classList.remove('active');
  document.getElementById('exploreBtn').onclick = () => {
    const newChain = contextChain ? [...contextChain, node.id] : [node.id];
    searchInput.value = node.id;
    focusChain(newChain);
  };
  document.getElementById('pinBtn').onclick = () => pinToMap(node);
}

function pinToMap(node) {
  if (!pinned.find(p => p.id === node.id)) pinned.push({ id: node.id, count: node.count });
  renderPinned();
}
function unpin(id) { pinned = pinned.filter(p => p.id !== id); selectedPins.delete(id); renderPinned(); }
function renderPinned() {
  const container = document.getElementById('mymapChips');
  if (pinned.length === 0) { container.innerHTML = '<span class="empty">Nothing pinned yet. Click a node above, then "Pin to my map."</span>'; return; }
  container.innerHTML = '';
  pinned.forEach(p => {
    const chip = document.createElement('span');
    chip.className = 'pin-chip' + (selectedPins.has(p.id) ? ' selected' : '');
    chip.innerHTML = `${p.id} <span class="jump" title="Jump to this concept">↗</span> <span class="x">✕</span>`;
    chip.querySelector('.jump').onclick = (e) => { e.stopPropagation(); searchInput.value = p.id; focusChain([p.id]); };
    chip.querySelector('.x').onclick = (e) => { e.stopPropagation(); unpin(p.id); };
    chip.onclick = () => { selectedPins.has(p.id) ? selectedPins.delete(p.id) : selectedPins.add(p.id); renderPinned(); };
    container.appendChild(chip);
  });
}

async function buildMyMap() {
  const termSet = selectedPins.size >= 2 ? [...selectedPins] : pinned.map(p => p.id);
  if (termSet.length < 2) { mapStatusEl.textContent = 'Pin (or select) at least 2 concepts first.'; return; }
  mapStatusEl.textContent = `Building your map from ${termSet.length} concepts…`;
  document.getElementById('buildMapBtn').disabled = true;
  try {
    const query = `(${termSet.map(t => `"${t}"`).join(' OR ')}) AND glioblastoma` + dateClause();
    const mapDict = termSet.map(t => BASE_DICTIONARY.find(d => d.id === t) || t);
    const data = await fetchAndExtract(query, filters.paperLimit, mapDict);

    const nodeLimit = parseInt(document.getElementById('nodeLimitSelect').value, 10);
    const keptNodes = [...data.nodes].sort((a, b) => b.count - a.count).slice(0, nodeLimit);
    const keptIds = new Set(keptNodes.map(n => n.id));
    const keptLinks = data.links.filter(l => keptIds.has(l.source) && keptIds.has(l.target));
    data.nodes = keptNodes; data.links = keptLinks;

    window.myMapData = data;
    const palette = PALETTES[document.getElementById('paletteSelect').value] || PALETTES.violet;
    buildForceGraph('mymap-graph', data, null, palette);
    document.getElementById('exportRow').style.display = 'flex';
    mapStatusEl.textContent = `Your map: ${data.totalPapers} papers scanned across ${termSet.length} concepts, showing top ${keptNodes.length}.`;
  } catch (err) {
    mapStatusEl.textContent = 'Something went wrong: ' + err.message;
  } finally {
    document.getElementById('buildMapBtn').disabled = false;
  }
}

// ---- Explainer: real GO/gene-summary data by default, AI only for relationships and non-gene fallback ----
async function fetchGeneCard(term) {
  try {
    const url = `https://mygene.info/v3/query?q=${encodeURIComponent(term)}&species=human&fields=symbol,name,summary,go.BP.term,go.MF.term,go.CC.term&size=1`;
    const res = await fetch(url);
    const data = await res.json();
    const hit = data.hits && data.hits[0];
    if (!hit || !hit.summary) return null;
    const goTerms = [];
    ['BP', 'MF', 'CC'].forEach(cat => {
      const g = hit.go && hit.go[cat];
      if (g) { const arr = Array.isArray(g) ? g : [g]; arr.slice(0, 2).forEach(x => goTerms.push(x.term)); }
    });
    return { symbol: hit.symbol || term, name: hit.name || '', summary: hit.summary, goTerms: goTerms.slice(0, 6) };
  } catch (e) { return null; }
}

async function explainSelection() {
  const termSet = selectedPins.size >= 1 ? [...selectedPins] : pinned.map(p => p.id);
  if (termSet.length === 0) { mapStatusEl.textContent = 'Select at least 1 pinned concept first (click a chip above).'; return; }
  const aiResult = document.getElementById('aiResult');
  aiResult.classList.add('active');
  aiResult.innerHTML = termSet.map(t => `<div class="ai-card" id="card-${t.replace(/\W/g,'')}"><h4>${t}</h4><p>Looking this up…</p></div>`).join('')
    + (termSet.length >= 2 ? `<div class="ai-card relationship" id="card-relationship"><h4>How they relate</h4><p>Thinking this through…</p></div>` : '');
  document.getElementById('explainBtn').disabled = true;

  await Promise.all(termSet.map(async term => {
    const cardEl = document.getElementById(`card-${term.replace(/\W/g,'')}`);
    const geneCard = await fetchGeneCard(term);
    if (geneCard) {
      cardEl.innerHTML = `
        <h4>${geneCard.symbol}${geneCard.name ? ' — ' + geneCard.name : ''}</h4>
        <p>${geneCard.summary.slice(0, 420)}${geneCard.summary.length > 420 ? '…' : ''}</p>
        ${geneCard.goTerms.length ? `<div class="go-chips">${geneCard.goTerms.map(g => `<span class="go-chip">${g}</span>`).join('')}</div>` : ''}
        <div class="note">Gene summary &amp; GO terms via MyGene.info — factual, not AI-generated.</div>`;
    } else {
      try {
        const text = await callClaude(`In 2-3 sentences, describe the established role of "${term}" in glioblastoma biology or treatment. If it's not a specific molecular target, describe it as accurately as you can in that context.`);
        cardEl.innerHTML = `<h4>${term}</h4><p>${text || 'No description available.'}</p><div class="note">No standalone gene record found — AI-generated description.</div>`;
      } catch (e) {
        cardEl.innerHTML = `<h4>${term}</h4><p>Could not retrieve a description right now.</p>`;
      }
    }
  }));

  if (termSet.length >= 2) {
    const relCard = document.getElementById('card-relationship');
    try {
      const text = await callClaude(`In 3-4 concise sentences grounded in established cancer biology, explain how ${termSet.join(', ')} relate to or interact with each other specifically in the context of glioblastoma. If they are not known to interact directly, say so plainly. Do not speculate beyond established literature.`);
      relCard.innerHTML = `<h4>How they relate</h4><p>${text || 'No explanation returned — try again.'}</p><div class="note">AI-generated synthesis — not a substitute for primary literature review.</div>`;
    } catch (err) {
      relCard.innerHTML = `<h4>How they relate</h4><p>Could not reach the explanation service right now.</p>`;
    }
  }
  document.getElementById('explainBtn').disabled = false;
}

function getMapSvgElement() { return document.querySelector('#mymap-graph svg'); }
function svgToString(svgEl) {
  const clone = svgEl.cloneNode(true);
  clone.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
  clone.style.background = '#ffffff';
  const rect = document.createElementNS('http://www.w3.org/2000/svg','rect');
  rect.setAttribute('width','100%'); rect.setAttribute('height','100%'); rect.setAttribute('fill','#ffffff');
  clone.insertBefore(rect, clone.firstChild);
  return new XMLSerializer().serializeToString(clone);
}
function downloadBlob(blob, filename) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
}
document.getElementById('exportSvg').onclick = () => {
  const svgEl = getMapSvgElement(); if (!svgEl) return;
  downloadBlob(new Blob([svgToString(svgEl)], { type: 'image/svg+xml' }), 'synapse-my-map.svg');
};
function renderMapToCanvas(callback) {
  const svgEl = getMapSvgElement(); if (!svgEl) return;
  const w = svgEl.width.baseVal.value, h = svgEl.height.baseVal.value;
  const img = new Image();
  const svgBlob = new Blob([svgToString(svgEl)], { type: 'image/svg+xml;charset=utf-8' });
  const url = URL.createObjectURL(svgBlob);
  img.onload = () => {
    const canvas = document.createElement('canvas');
    canvas.width = w * 2; canvas.height = h * 2;
    const ctx = canvas.getContext('2d');
    ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.scale(2, 2);
    ctx.drawImage(img, 0, 0, w, h);
    URL.revokeObjectURL(url);
    callback(canvas);
  };
  img.src = url;
}
document.getElementById('exportPng').onclick = () => {
  renderMapToCanvas(canvas => canvas.toBlob(blob => downloadBlob(blob, 'synapse-my-map.png')));
};
document.getElementById('exportPdf').onclick = () => {
  renderMapToCanvas(canvas => {
    const { jsPDF } = window.jspdf;
    const pdf = new jsPDF({ orientation: 'landscape', unit: 'pt', format: [canvas.width/2, canvas.height/2] });
    pdf.addImage(canvas.toDataURL('image/png'), 'PNG', 0, 0, canvas.width/2, canvas.height/2);
    pdf.save('synapse-my-map.pdf');
  });
};

document.getElementById('buildMapBtn').onclick = buildMyMap;
document.getElementById('explainBtn').onclick = explainSelection;

document.getElementById('applyFiltersBtn').onclick = () => {
  filters.paperLimit = parseInt(document.getElementById('paperLimitSelect').value, 10);
  let yf = parseInt(document.getElementById('yearFromInput').value, 10);
  let yt = parseInt(document.getElementById('yearToInput').value, 10);
  if (yf > yt) { const tmp = yf; yf = yt; yt = tmp; }
  filters.yearFrom = yf; filters.yearTo = yt;
  currentChain === null ? loadOverview() : focusChain(currentChain);
};

document.getElementById('copyCiteBtn').onclick = () => {
  const text = 'Sarthak, S. (2026). SYNAPSE: a living map of glioblastoma research [interactive tool]. Built with Claude (Anthropic). Underlying data: NCBI PubMed / Entrez E-utilities, MyGene.info.';
  navigator.clipboard.writeText(text).then(() => {
    const btn = document.getElementById('copyCiteBtn');
    const old = btn.textContent; btn.textContent = 'Copied ✓';
    setTimeout(() => btn.textContent = old, 1500);
  }).catch(() => {});
};

function runSearch() {
  const raw = searchInput.value.trim();
  if (!raw) return;
  const canonical = resolveToCanonical(raw);
  searchInput.value = canonical;
  focusChain([canonical]);
}
searchBtn.addEventListener('click', runSearch);
searchInput.addEventListener('keydown', e => { if (e.key === 'Enter') runSearch(); });

loadOverview();

document.getElementById('howItWorksBtn').onclick = () => document.getElementById('howModal').classList.add('active');
document.getElementById('closeModal').onclick = () => document.getElementById('howModal').classList.remove('active');
document.getElementById('howModal').addEventListener('click', (e) => {
  if (e.target.id === 'howModal') e.currentTarget.classList.remove('active');
});
</script>

</body>
</html>
